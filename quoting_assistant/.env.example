# Copy to .env and fill in. Never commit .env.
# Leave empty to run the chat in offline mode (rule-based intake, no API calls).
ANTHROPIC_API_KEY=
# Models (from CLAUDE.md, section 5)
MODEL_CHAT=claude-sonnet-5-5
MODEL_EXTRACT=claude-haiku-5-5
# Where SQLite and uploaded files live
DATA_DIR=data
# Public base URL the widget calls (used in the <script> snippet)
PUBLIC_BASE_URL=http://127.0.0.1:8000
